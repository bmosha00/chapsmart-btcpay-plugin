<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <!-- Plugin specific properties -->
  <PropertyGroup>
    <Product>ChapSmart Cashout</Product>
    <Description>Auto-convert Bitcoin to TZS via M-Pesa. When a BTCPay invoice settles, ChapSmart sends TZS to the merchants registered M-Pesa number via Lightning.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- NuGet Package properties for BTCPay Plugin Directory -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>BTCPayServer.Plugins.ChapSmart</PackageId>
    <Authors>ChapSmart Payments</Authors>
    <Copyright>Copyright (c) 2026 ChapSmart Payments</Copyright>
    <PackageProjectUrl>https://github.com/bmosha00/chapsmart-btcpay-plugin</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bmosha00/chapsmart-btcpay-plugin</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>btcpay plugin chapsmart mpesa tanzania lightning cashout bitcoin mobile-money</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>chapsmart-logo.png</PackageIcon>
  </PropertyGroup>

  <!-- Plugin development properties -->
  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <PreserveCompilationContext>false</PreserveCompilationContext>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ProjectReference>
      <Properties>StaticWebAssetsEnabled=false</Properties>
      <Private>false</Private>
      <ExcludeAssets>runtime;native;build;buildTransitive;contentFiles</ExcludeAssets>
    </ProjectReference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ProjectReference Include="..\btcpayserver\BTCPayServer\BTCPayServer.csproj" />
    <EmbeddedResource Include="Resources\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="Resources\img\chapsmart-logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
