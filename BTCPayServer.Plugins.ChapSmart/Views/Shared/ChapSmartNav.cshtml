@using BTCPayServer
@using BTCPayServer.Client
@{
    var store = Context.GetStoreData();
    if (store is null) return;
}
<li class="nav-item" permission="@Policies.CanModifyStoreSettings">
    <a asp-area="" asp-controller="UIChapSmart" asp-action="EditChapSmart" asp-route-storeId="@store.Id" id="StoreNav-ChapSmart">
        <img src="/stores/@store.Id/plugins/chapsmart/logo.png" alt="" style="height:1.1em;vertical-align:middle;margin-right:4px;" /> ChapSmart
    </a>
</li>
