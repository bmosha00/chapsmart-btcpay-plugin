@model ChapSmartSettingsViewModel
@{
    ViewData["Title"] = "ChapSmart Settings";
    
}

<div class="row">
    <div class="col-xxl-constrain col-xl-8">
        <h3 class="mb-2">
            <img src="/stores/@Model.StoreId/plugins/chapsmart/logo.png" alt="ChapSmart" style="height:32px;vertical-align:middle;margin-right:8px;" /> ChapSmart — M-Pesa Payout
        </h3>
        <p class="text-secondary mb-4">
            Automatically send TZS to M-Pesa when a BTCPay invoice is paid.
            Invoices must include <code>phoneNumber</code> and <code>amountTZS</code> in their metadata.
        </p>

        @if (ViewBag.SuccessMessage is string successMsg)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @successMsg
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (ViewBag.ErrorMessage is string errorMsg)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMsg
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <form method="post" asp-action="SaveSettings" asp-route-storeId="@Model.StoreId">
            <!-- General Settings -->
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3">General</h5>

                    <div class="form-check mb-3">
                        <input asp-for="Settings.Enabled" type="checkbox" class="form-check-input" />
                        <label asp-for="Settings.Enabled" class="form-check-label">
                            Enable ChapSmart M-Pesa payouts for this store
                        </label>
                    </div>

                    <div class="form-check mb-1">
                        <input asp-for="Settings.AutoPayout" type="checkbox" class="form-check-input" />
                        <label asp-for="Settings.AutoPayout" class="form-check-label">
                            Automatic payout on invoice settlement
                        </label>
                        <div class="form-text">When disabled, payouts appear in the dashboard for manual review.</div>
                    </div>
                </div>
            </div>

            <!-- API Connection -->
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title mb-3">API Connection</h5>

                    <div class="mb-3">
                        <label asp-for="Settings.ChapSmartApiUrl" class="form-label">API URL</label>
                        <input asp-for="Settings.ChapSmartApiUrl" class="form-control" placeholder="https://api.chapsmart.com" />
                        <div class="form-text">Your ChapSmart payout API base URL.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Settings.ChapSmartApiKey" class="form-label">API Key</label>
                        <input asp-for="Settings.ChapSmartApiKey" class="form-control" placeholder="chp_..." />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Settings.ChapSmartApiSecret" class="form-label">API Secret</label>
                        <input asp-for="Settings.ChapSmartApiSecret" class="form-control" type="password" />
                    </div>
                </div>
            </div>
            <!-- Action Buttons -->
            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-primary" id="SaveSettings">Save Settings</button>
                <button type="submit"
                        formaction="@Url.Action("TestConnection", "UIChapSmart", new { storeId = Model.StoreId })"
                        class="btn btn-secondary" id="TestConnection">
                    Test Connection
                </button>
                <a asp-action="Dashboard" asp-route-storeId="@Model.StoreId"
                   class="btn btn-outline-info">
                    Payout Dashboard →
                </a>
            </div>
        </form>
    </div>
</div>
