@model ChapSmartPayoutDetailViewModel
@{
    ViewData["Title"] = "Cashout Detail";
}

<div class="row">
    <div class="col-xxl-constrain col-xl-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3>
                <img src="/stores/@Model.StoreId/plugins/chapsmart/logo.png" alt="ChapSmart" style="height:32px;vertical-align:middle;margin-right:8px;" />
                Cashout Detail
            </h3>
            <a asp-action="Dashboard" asp-route-storeId="@Model.StoreId"
               class="btn btn-sm btn-outline-secondary">
                ← Back to History
            </a>
        </div>

        <div class="card">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Cashout ID</dt>
                    <dd class="col-sm-8"><code>@(Model.Payout.PaymentProviderTransId ?? "—")</code></dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @switch (Model.Payout.Status)
                        {
                            case "lightning_paid":
                                <span class="badge bg-success">Lightning Paid</span>
                                break;
                            case "failed":
                                <span class="badge bg-danger">Failed</span>
                                break;
                            case "processing":
                                <span class="badge bg-warning text-dark">Processing</span>
                                break;
                            case "paying_lightning":
                                <span class="badge bg-info">Paying Lightning</span>
                                break;
                            default:
                                <span class="badge bg-secondary">@Model.Payout.Status</span>
                                break;
                        }
                    </dd>

                    <dt class="col-sm-4">Amount (TZS)</dt>
                    <dd class="col-sm-8"><strong>@Model.Payout.AmountTZS.ToString("N0") TZS</strong></dd>

                    <dt class="col-sm-4">Amount (BTC)</dt>
                    <dd class="col-sm-8">@Model.Payout.AmountBTC BTC (@((Model.Payout.AmountBTC * 100000000m).ToString("N0")) sats)</dd>

                    <dt class="col-sm-4">BTCPay Invoice</dt>
                    <dd class="col-sm-8">
                        <a href="/invoices/@Model.Payout.InvoiceId">@Model.Payout.InvoiceId</a>
                    </dd>

                    <dt class="col-sm-4">Merchant ID</dt>
                    <dd class="col-sm-8"><code>@Model.Payout.PhoneNumber</code></dd>

                    <dt class="col-sm-4">Created</dt>
                    <dd class="col-sm-8">@Model.Payout.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>

                    <dt class="col-sm-4">Completed</dt>
                    <dd class="col-sm-8">@(Model.Payout.CompletedAt?.ToString("yyyy-MM-dd HH:mm:ss UTC") ?? "—")</dd>

                    <dt class="col-sm-4">Retry Count</dt>
                    <dd class="col-sm-8">@Model.Payout.RetryCount</dd>

                    @if (!string.IsNullOrEmpty(Model.Payout.ErrorMessage))
                    {
                        <dt class="col-sm-4">Error / Info</dt>
                        <dd class="col-sm-8"><span class="text-danger">@Model.Payout.ErrorMessage</span></dd>
                    }

                    @if (!string.IsNullOrEmpty(Model.Payout.ResponseData))
                    {
                        <dt class="col-sm-4">API Response</dt>
                        <dd class="col-sm-8"><pre class="bg-light p-2 rounded small mb-0">@Model.Payout.ResponseData</pre></dd>
                    }
                </dl>
            </div>
        </div>
    </div>
</div>
