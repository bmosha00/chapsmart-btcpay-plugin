@model ChapSmartDashboardViewModel
@{
    ViewData["Title"] = "ChapSmart Cashout History";
}

<div class="row">
    <div class="col-xxl-constrain">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3>
                <img src="/stores/@Model.StoreId/plugins/chapsmart/logo.png" alt="ChapSmart" style="height:32px;vertical-align:middle;margin-right:8px;" />
                Cashout History
            </h3>
            <a asp-action="EditChapSmart" asp-route-storeId="@Model.StoreId"
               class="btn btn-sm btn-outline-secondary">
                ← Settings
            </a>
        </div>

        <div class="row mb-4 g-3">
            <div class="col-6 col-md-3">
                <div class="card">
                    <div class="card-body text-center py-4">
                        <div class="text-secondary small mb-1">Total Cashouts</div>
                        <div class="fs-3 fw-bold">@Model.Stats.TotalPayouts</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card">
                    <div class="card-body text-center py-4">
                        <div class="text-secondary small mb-1">Completed</div>
                        <div class="fs-3 fw-bold text-success">@Model.Stats.CompletedPayouts</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card">
                    <div class="card-body text-center py-4">
                        <div class="text-secondary small mb-1">Failed</div>
                        <div class="fs-3 fw-bold text-danger">@Model.Stats.FailedPayouts</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card">
                    <div class="card-body text-center py-4">
                        <div class="text-secondary small mb-1">Volume (TZS)</div>
                        <div class="fs-3 fw-bold">@Model.Stats.TotalAmountTZS.ToString("N0")</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mb-3 d-flex gap-2 flex-wrap">
            <a asp-action="Dashboard" asp-route-storeId="@Model.StoreId"
               class="btn btn-sm @(Model.FilterStatus == null ? "btn-primary" : "btn-outline-primary")">All</a>
            <a asp-action="Dashboard" asp-route-storeId="@Model.StoreId" asp-route-status="lightning_paid"
               class="btn btn-sm @(Model.FilterStatus == "lightning_paid" ? "btn-success" : "btn-outline-success")">Paid</a>
            <a asp-action="Dashboard" asp-route-storeId="@Model.StoreId" asp-route-status="failed"
               class="btn btn-sm @(Model.FilterStatus == "failed" ? "btn-danger" : "btn-outline-danger")">Failed</a>
            <a asp-action="Dashboard" asp-route-storeId="@Model.StoreId" asp-route-status="processing"
               class="btn btn-sm @(Model.FilterStatus == "processing" ? "btn-warning" : "btn-outline-warning")">Processing</a>
        </div>

        @if (Model.Payouts != null && Model.Payouts.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Amount (TZS)</th>
                            <th>Sats</th>
                            <th>Status</th>
                            <th>CashoutId</th>
                            <th>Invoice</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payout in Model.Payouts)
                        {
                            <tr>
                                <td>@payout.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="fw-semibold">@payout.AmountTZS.ToString("N0")</td>
                                <td>@((payout.AmountBTC * 100000000m).ToString("N0"))</td>
                                <td>
                                    @switch (payout.Status)
                                    {
                                        case "lightning_paid":
                                            <span class="badge bg-success">Paid</span>
                                            break;
                                        case "failed":
                                            <span class="badge bg-danger">Failed</span>
                                            break;
                                        case "processing":
                                            <span class="badge bg-warning text-dark">Processing</span>
                                            break;
                                        case "paying_lightning":
                                            <span class="badge bg-info">Paying</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@payout.Status</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <span class="text-truncate d-inline-block" style="max-width: 100px;"
                                          title="@payout.PaymentProviderTransId">
                                        @(payout.PaymentProviderTransId ?? "—")
                                    </span>
                                </td>
                                <td>
                                    <a href="/invoices/@payout.InvoiceId"
                                       class="text-truncate d-inline-block" style="max-width: 100px;"
                                       title="@payout.InvoiceId">
                                        @payout.InvoiceId
                                    </a>
                                </td>
                                <td>
                                    <a asp-action="PayoutDetail"
                                       asp-route-storeId="@Model.StoreId"
                                       asp-route-payoutId="@payout.Id"
                                       class="btn btn-sm btn-outline-info">Detail</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info mt-3">
                <strong>No cashouts yet.</strong> Cashouts appear here when BTCPay invoices with
                <code>amountTZS</code> metadata settle and are automatically cashed out to M-Pesa.
            </div>
        }
    </div>
</div>
